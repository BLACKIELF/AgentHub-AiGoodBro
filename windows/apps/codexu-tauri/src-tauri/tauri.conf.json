{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AiGoodBro",
  "version": "3.0.0",
  "identifier": "com.blackielf.codex-account-manager-next.windows",
  "build": {
    "beforeDevCommand": "node src-tauri/scripts/frontend-hook.mjs dev",
    "beforeBuildCommand": "node src-tauri/scripts/frontend-hook.mjs build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../web/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "AiGoodBro",
        "width": 960,
        "height": 760,
        "minWidth": 720,
        "minHeight": 540,
        "center": true,
        "visible": false,
        "decorations": true,
        "transparent": false,
        "focus": false
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default", "compact"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "publisher": "AiGoodBro contributors",
    "copyright": "© 2026 AiGoodBro contributors",
    "category": "DeveloperTool",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "wix": {
        "language": { "en-US": { "localePath": "installer/encoding-en-US.wxl" } },
        "upgradeCode": "6cd62ac1-9ad0-5e9e-a4e1-c78c6a73fd03",
        "template": "installer/wix-main.wxs"
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "languages": ["English"],
        "template": "installer/nsis-installer.nsi"
      }
    }
  }
}
