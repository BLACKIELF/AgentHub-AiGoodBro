+    fn test_incremental_split_between_record_and_compacted_matches_full_parse() {
+        let full = compaction_rollout("codex_vscode");
+        let cut = full.find(r#""type":"compacted""#).unwrap();
+        let cut = full[..cut].rfind('\n').unwrap() + 1;
